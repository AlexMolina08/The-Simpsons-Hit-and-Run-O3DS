.ivec u_lightLoop
.bool u_hasLights
.bool u_lit

.fvec u_proj[4]

.fvec u_eye_lightPos[4]
.fvec u_eye_lightColour[4]
.fvec u_eye_lightAtten[4]

.fvec u_eye_matAmbient
.fvec u_eye_matDiffuse
.fvec u_eye_matEmissive
.fvec u_eye_sceneAmbient

.fvec u_bones[75]
.alias in_weights v4
.alias in_offsets v5

.alias zeros  u_eye_matEmissive.wwww
.alias ones   u_eye_matAmbient.wwww
.alias fixclr u_eye_sceneAmbient.wwww

.alias in_pos    v0
.alias in_normal v1
.alias in_tex0   v2
.alias in_colour v3

.out o_pos    position
.out o_colour color
.out o_tex0   texcoord0

.entry vmain
.proc vmain
	mov r0.xyz, in_pos
	mov r0.w, ones
	mova a0.x, in_offsets.x
	dp3 r5.x, u_bones[a0.x+0], in_normal
	dp3 r5.y, u_bones[a0.x+1], in_normal
	dp3 r5.z, u_bones[a0.x+2], in_normal
	dp4 r1.x, u_bones[a0.x+0], r0
	dp4 r1.y, u_bones[a0.x+1], r0
	dp4 r1.z, u_bones[a0.x+2], r0
	mov r3, in_weights
	cmp zeros, gt, gt, in_offsets.wwww
	jmpc cmp.x, SkinDone
	mul r1.xyz, r1, r3.xxxx
	mova a0.x, in_offsets.y
	dp4 r2.x, u_bones[a0.x+0], r0
	dp4 r2.y, u_bones[a0.x+1], r0
	dp4 r2.z, u_bones[a0.x+2], r0
	mul r2.xyz, r2, r3.yyyy
	add r1.xyz, r1, r2
	mova a0.x, in_offsets.z
	dp4 r2.x, u_bones[a0.x+0], r0
	dp4 r2.y, u_bones[a0.x+1], r0
	dp4 r2.z, u_bones[a0.x+2], r0
	mul r2.xyz, r2, r3.zzzz
	add r1.xyz, r1, r2
	mova a0.x, in_offsets.w
	dp4 r2.x, u_bones[a0.x+0], r0
	dp4 r2.y, u_bones[a0.x+1], r0
	dp4 r2.z, u_bones[a0.x+2], r0
	mul r2.xyz, r2, r3.wwww
	add r1.xyz, r1, r2
SkinDone:
	mov r0.xyz, r1
	mov r0.w, ones
	mov r8, r0

	dp4	r1.x, u_proj[0], r8
	dp4	r1.y, u_proj[1], r8
	dp4	r1.z, u_proj[2], r8
	dp4	r1.w, u_proj[3], r8

	mov	o_pos, r1

	mov	o_tex0, in_tex0

	ifu u_lit
	call	DoLighting
	.else
	mul	r0, fixclr, in_colour
	.end

	mov	o_colour, r0
	end
.end

.proc DoLighting
	mov r9.xyz, r5.xyz
	dp3	r2.x, r9.xyz, r9.xyz
	rsq	r2.x, r2.x
	mul	r9.xyz, r9.xyz, r2.xxx

	mov	r0, u_eye_matEmissive
	mov	r3, u_eye_sceneAmbient
	mov	r4, u_eye_matAmbient
	mad	r0.rgb, r4.rgb, r3.rgb, r0.rgb

	mov	r7, u_eye_matDiffuse

	ifu u_hasLights
	for u_lightLoop
	mov	r15, u_eye_lightPos[aL]
	mov	r14, u_eye_lightColour[aL]
	mov	r13, u_eye_lightAtten[aL]

	mul	r2.xyz, r8.xyz, r15.www
	add	r1.xyz, r15.xyz, -r2.xyz

	dp3	r2.x, r1.xyz, r1.xyz
	rsq	r2.y, r2.x
	mul	r1.xyz, r1.xyz, r2.yyy
	rcp	r2.z, r2.y

	mov	r3.x, r13.x
	mad	r3.x, r13.yyy, r2.zzz, r3.x
	mad	r3.x, r13.zzz, r2.xxx, r3.x
	rcp	r5.x, r3.x

	dp3	r6.x, r9.xyz, r1.xyz
	max	r6.x, zeros, r6.x
	mul	r6.x, r6.x, r5.x
	mul	r4.rgb, r7.rgb, r14.rgb
	mad	r0.rgb, r4.rgb, r6.xxx, r0.rgb
	.end

	.end

	max	r0, zeros, r0
	min	r0, ones,  r0
	mov	r0.w, r7.w
.end
